-- 4. OCULTAR / EXIBIR INTERFACE (MODO CLEAN)
--------------------------------------------------------------------------------
local function IsDriveControl(instance)
    local n = instance.Name:lower()
    local keywords = {
        "touch", "mobile", "control", "drive", "vehicle", "carcontrol",
        "brake", "freio", "handbrake", "accel", "gas", "pedal", "steer", "steering",
        "arrow", "joystick", "thumbstick", "seat", "exit", "enter", "rayfield", "rdx", "fps"
    }
    for _, kw in ipairs(keywords) do
        if n:find(kw) then
            return true
        end
    end
    return false
end

local function ToggleCleanHUD(state)
    pcall(function()
        local pgui = Plr:FindFirstChild("PlayerGui")
        if not pgui then return end

        if state then
            HiddenElements = {}
            for _, gui in ipairs(pgui:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    if not IsDriveControl(gui) then
                        for _, child in ipairs(gui:GetChildren()) do
                            if child:IsA("GuiObject") and child.Visible and not IsDriveControl(child) then
                                table.insert(HiddenElements, child)
                                child.Visible = false
                            end
                        end
                    end
                end
            end
        else
            for _, elem in ipairs(HiddenElements) do
                if elem and elem.Parent then
                    elem.Visible = true
                end
            end
            HiddenElements = {}
        end
    end)
end

