local function ToggleFPSBoost(state)
    pcall(function()
        if state then
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") then
                    v:Destroy()
                end
            end
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    v.Enabled = false
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v:Destroy()
                end
            end
        end
    end)
end

local function ToggleRemoveTreesAndPosts(state)
    pcall(function()
        if state then
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("Model") or v:IsA("BasePart") then
                    local name = v.Name:lower()
                    if name:find("tree") or name:find("arvore") or name:find("árvore") or name:find("bush") or name:find("arbusto") or name:find("post") or name:find("poste") or name:find("lightpole") or name:find("plant") or name:find("planta") then
                        v:Destroy()
                    end
                end
            end
        end
    end)
end

local function ToggleLowTextures(state)
    pcall(function()
        if state then
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("MeshPart") then
                    v.TextureID = ""
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v:Destroy()
                end
            end
        end
    end)
end

local function ToggleRemoveParticles(state)
    pcall(function()
        if state then
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Explosion") then
                    v:Destroy()
                end
            end
        end
    end)
end

local function ToggleWhiteScreen(state)
    pcall(function()
        local guiName = "RDX_WhiteScreenOptimizer"
        local existing = CoreGui:FindFirstChild(guiName) or Plr.PlayerGui:FindFirstChild(guiName)
        if state and not existing then
            local sg = Instance.new("ScreenGui")
            sg.Name = guiName
            sg.IgnoreGuiInset = true
            sg.ZIndexBehavior = Enum.ZIndexBehavior.Global
            sg.Parent = Plr.PlayerGui
            
            local fr = Instance.new("Frame")
            fr.Size = UDim2.new(1, 0, 1, 0)
            fr.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            fr.Parent = sg
        elseif not state and existing then
            existing:Destroy()
        end
    end)
end

