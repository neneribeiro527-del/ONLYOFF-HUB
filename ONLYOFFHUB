local function UpdateNickDisplay()
    pcall(function()
        if not VerificarPermissaoDono() then return end -- Se não for o dono, bloqueia a execução do nick personalizado

        local c = Plr.Character if not c then return end
        local h = c:FindFirstChild("Head") if not h then return end
        local b = h:FindFirstChild("RDX_HeadNick")
        
        if not ShowNickEnabled then
            if b then b:Destroy() end
            return
        end

        if not b then
            b = Instance.new("BillboardGui")
            b.Name = "RDX_HeadNick"
            b.Adornee = h
            b.Size = UDim2.new(0, 300, 0, 50)
            b.AlwaysOnTop = true
            b.Parent = h

            TLRef = Instance.new("TextLabel")
            TLRef.Name = "NickText"
            TLRef.Size = UDim2.new(1, 0, 1, 0)
            TLRef.BackgroundTransparency = 1
            TLRef.TextStrokeTransparency = 0
            TLRef.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            TLRef.Parent = b
        else
            TLRef = b:FindFirstChild("NickText")
        end

        if b then
            b.StudsOffset = Vector3.new(0, NickHeight, 0)
        end

        if TLRef then
            TLRef.TextSize = NickSize
            TLRef.Font = SelectedFont
            if not RGBEnabled then TLRef.TextColor3 = NickColor end
            TLRef.Text = Nick .. (Icon ~= "" and (" " .. Icon) or "")
        end
    end)
end
task.spawn(function() while task.wait(1) do UpdateNickDisplay() end end)

