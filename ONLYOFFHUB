RunService.RenderStepped:Connect(function(dt)
    pcall(function()
        UpdateDriftLogic(dt)
        UpdateCameraLogic()

        if FPSDisplayEnabled and FPSLabel then
            FrameCounter = FrameCounter + 1
            local now = tick()
            if now - LastFPSTime >= 0.5 then
                local fps = math.floor(FrameCounter / (now - LastFPSTime))
                FPSLabel.Text = "FPS: " .. tostring(fps)
                FrameCounter = 0
                LastFPSTime = now
            end
        end

        if Workspace.Gravity ~= TargetGravity then
            Workspace.Gravity = TargetGravity
        end

        if SpdE and Plr.Character and Plr.Character:FindFirstChildOfClass("Humanoid") then
            Plr.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = SpdV
        end
    end)
end)
