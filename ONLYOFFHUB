local function ApplyCarColor()
    pcall(function()
        local car, _ = GetCar()
        if not car then return end
        for _, part in ipairs(car:GetDescendants()) do
            if part:IsA("BasePart") and not (part.Name:lower():find("wheel") or part.Name:lower():find("roda") or part.Name:lower():find("glass") or part.Name:lower():find("vidro")) then
                part.Color = CarColor
            end
        end
    end)
end

local function ApplyExhaustMod()
    pcall(function()
        local car, _ = GetCar()
        if not car then return end
        for _, part in ipairs(car:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name:lower():find("exhaust") or part.Name:lower():find("escapamento") or part.Name:lower():find("pipe")) then
                if not OriginalExhaustSizes[part] then
                    OriginalExhaustSizes[part] = part.Size
                end
                local baseSize = OriginalExhaustSizes[part]
                part.Size = Vector3.new(baseSize.X * ExhaustScaleThick, baseSize.Y * ExhaustScaleThick, baseSize.Z * ExhaustScaleLen)
            end
        end
    end)
end

