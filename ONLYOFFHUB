local function ToggleFreeCam(state)
    FreeCamEnabled = state
    pcall(function()
        if state then
            Camera.CameraType = Enum.CameraType.Scriptable
            FreeCamCFrame = Camera.CFrame
            local rx, ry, _ = Camera.CFrame:ToOrientation()
            FreeCamRot = Vector2.new(rx, ry)

            if UserInputService.TouchEnabled then
                CreateFreeCamMobileControls()
            end
        else
            Camera.CameraType = Enum.CameraType.Custom
            if FreeCamTouchControls then
                FreeCamTouchControls:Destroy()
                FreeCamTouchControls = nil
            end
            FreeCamMoveDir = Vector3.new(0,0,0)
        end
    end)
end

-- Rotação por toque/arraste na tela
UserInputService.InputChanged:Connect(function(input, gpe)
    if FreeCamEnabled and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Delta
            FreeCamRot = FreeCamRot - Vector2.new(delta.Y * 0.005, delta.X * 0.005)
        end
    end
end)

local function UpdateCameraLogic()
    pcall(function()
        if FixCamEnabled then
            Camera.CameraType = Enum.CameraType.Scriptable
            if SavedCamCFrame then
                Camera.CFrame = SavedCamCFrame
            end
            return
        end

        if FreeCamEnabled then
            Camera.CameraType = Enum.CameraType.Scriptable
            local keyboardDir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then keyboardDir = keyboardDir + Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then keyboardDir = keyboardDir + Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then keyboardDir = keyboardDir + Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then keyboardDir = keyboardDir + Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then keyboardDir = keyboardDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then keyboardDir = keyboardDir + Vector3.new(0, -1, 0) end

            local moveVector = keyboardDir + FreeCamMoveDir
            local rotationCFrame = CFrame.Angles(0, FreeCamRot.Y, 0) * CFrame.Angles(FreeCamRot.X, 0, 0)
            
            FreeCamCFrame = FreeCamCFrame + (rotationCFrame:VectorToWorldSpace(moveVector) * FreeCamSpeed)
            Camera.CFrame = CFrame.new(FreeCamCFrame.Position) * rotationCFrame
            return
        end

        -- FOV e Esticador
        if CustomFOVEnabled or StretchedCamEnabled then
            local baseFOV = CustomFOVEnabled and TargetFOV or 70
            if StretchedCamEnabled then
                Camera.FieldOfView = math.clamp(baseFOV * StretchAmount, 10, 120)
            else
                Camera.FieldOfView = baseFOV
            end
        end
    end)
end

