local function ApplyGrayShader(state)
    pcall(function()
        local cc = Lighting:FindFirstChild("RDX_GrayCC")
        if state then
            Lighting.FogColor = Color3.fromRGB(130, 135, 140)
            Lighting.FogStart = 20
            Lighting.FogEnd = 400
            Lighting.OutdoorAmbient = Color3.fromRGB(100, 100, 105)
            if not cc then
                cc = Instance.new("ColorCorrectionEffect")
                cc.Name = "RDX_GrayCC"
                cc.Saturation = -0.5
                cc.TintColor = Color3.fromRGB(180, 185, 190)
                cc.Parent = Lighting
            end
        else
            Lighting.FogColor = DefFogColor
            Lighting.FogStart = DefFogStart
            Lighting.FogEnd = DefFogEnd
            Lighting.OutdoorAmbient = DefOutdoorAmbient
            if cc then cc:Destroy() end
        end
    end)
end

local function ApplyPurpleShader(state)
    pcall(function()
        local cc = Lighting:FindFirstChild("RDX_PurpleCC")
        if state then
            Lighting.FogColor = Color3.fromRGB(140, 90, 190)
            Lighting.FogStart = 50
            Lighting.FogEnd = 800
            Lighting.OutdoorAmbient = Color3.fromRGB(160, 100, 220)
            if not cc then
                cc = Instance.new("ColorCorrectionEffect")
                cc.Name = "RDX_PurpleCC"
                cc.TintColor = Color3.fromRGB(210, 170, 255)
                cc.Saturation = 0.2
                cc.Parent = Lighting
            end
        else
            Lighting.FogColor = DefFogColor
            Lighting.FogStart = DefFogStart
            Lighting.FogEnd = DefFogEnd
