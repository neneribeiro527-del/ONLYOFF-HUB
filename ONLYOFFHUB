local function GetCar()
    local c = Plr.Character if not c then return nil, nil end
    local hum = c:FindFirstChildOfClass("Humanoid") if not hum or not hum.SeatPart then return nil, nil end
    local seat = hum.SeatPart
    local model = seat:FindFirstAncestorOfClass("Model")
    while model and model.Parent and model.Parent:IsA("Model") and model.Parent ~= Workspace do
        model = model.Parent
    end
    return model, seat
end

