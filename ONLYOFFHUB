local function CreateDriftUI()
    pcall(function()
        local guiName = "RDX_DriftCounterGui"
        local existing = CoreGui:FindFirstChild(guiName) or Plr.PlayerGui:FindFirstChild(guiName)
        if existing then existing:Destroy() end

        local sg = Instance.new("ScreenGui")
        sg.Name = guiName
        sg.ResetOnSpawn = false
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        sg.Parent = Plr.PlayerGui

        local mainLabel = Instance.new("TextLabel")
        mainLabel.Name = "DriftMain"
        mainLabel.Size = UDim2.new(0, 300, 0, 40)
        mainLabel.Position = UDim2.new(0.5, -150, 0, 60)
        mainLabel.BackgroundTransparency = 1
        mainLabel.Font = Enum.Font.GothamBlack
        mainLabel.TextSize = 22
        mainLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        mainLabel.TextStrokeTransparency = 0.2
        mainLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        mainLabel.Text = ""
        mainLabel.Parent = sg

        DriftGui = sg
        DriftLabel = mainLabel
    end)
end

local function UpdateDriftLogic(dt)
    if not DriftEnabled then
        if DriftGui then DriftGui.Enabled = false end
        return
    end

    if not DriftGui or not DriftGui.Parent then
        CreateDriftUI()
    end
    DriftGui.Enabled = true

    pcall(function()
        local car, seat = GetCar()
        if car and seat then
            local velocity = seat.AssemblyLinearVelocity
            local speed = velocity.Magnitude
            local moveDir = velocity.Unit
            local lookDir = seat.CFrame.LookVector

            local dot = lookDir:Dot(moveDir)
            local angle = math.acos(math.clamp(dot, -1, 1)) * (180 / math.pi)

            if speed > 15 and angle > 15 and angle < 160 then
                IsDrifting = true
                LastDriftTime = tick()

                if CurrentDriftScore > 8000 then DriftMultiplier = 5
                elseif CurrentDriftScore > 4000 then DriftMultiplier = 4
                elseif CurrentDriftScore > 1800 then DriftMultiplier = 3
                elseif CurrentDriftScore > 500 then DriftMultiplier = 2
                else DriftMultiplier = 1 end

                local addedPoints = math.floor((angle * (speed / 10)) * dt * 2 * DriftMultiplier)
                CurrentDriftScore = CurrentDriftScore + addedPoints

                if DriftLabel then
                    if DriftMultiplier > 1 then
                        DriftLabel.Text = tostring(CurrentDriftScore) .. "  x" .. tostring(DriftMultiplier)
                    else
                        DriftLabel.Text = tostring(CurrentDriftScore)
                    end
                end
            else
                if IsDrifting and (tick() - LastDriftTime > 1.0) then
                    IsDrifting = false
                    TotalDriftPoints = TotalDriftPoints + CurrentDriftScore
                    CurrentDriftScore = 0
                    DriftMultiplier = 1
                    if DriftLabel then DriftLabel.Text = "" end
                end
            end
        else
            if IsDrifting then
                IsDrifting = false
                CurrentDriftScore = 0
                DriftMultiplier = 1
            end
            if DriftLabel then DriftLabel.Text = "" end
        end
    end)
end

